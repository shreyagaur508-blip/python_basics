tup = (2,3,4,56) # This will create a tuple 'tup' with the elements 2, 3, 4, and 56
print(tup)
print(type(tup))  # This will print the type of the variable 'tup', which is <class 'tuple'>
print(tup[1])  # This will print the second element of the tuple 'tup', which is 3

# single element tuple
tup1 = (2,) # This will create a tuple 'tup1' with a single element 2
print(tup1)