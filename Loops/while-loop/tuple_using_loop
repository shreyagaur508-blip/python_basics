#search for a number x in tuple using while loop
num = (1,4,9,16,25,36,49,64,81,100)

x = int(input("Enter a number to search:"))

i = 0 #initialize index

while i < len(num):
    if num[i] == x:
        print("Found at index", i)
        break
    else:
        print("Not found at index", i)
    i += 1      